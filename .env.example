# ===== LLM 配置（OpenAI 兼容接口）=====
# 美团 LongCat-2.0（Agentic 模型，默认推荐）
OPENAI_BASE_URL=https://api.longcat.chat/openai/v1
OPENAI_API_KEY=ak_xxxxx

# 其他兼容选项（任选其一，去掉注释）：
# OpenAI 官方:    OPENAI_API_KEY=sk-xxxxx
# 通义千问:       OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                 OPENAI_API_KEY=sk-xxxxx


# ===== Embedding 配置（向量检索用，与 LLM 独立）=====
# 讯飞 MaaS embedding（768维，免费额度，国内访问快）
EMBEDDING_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
EMBEDDING_API_KEY=xxxxx:xxxxx

# 其他兼容选项：
# 通义 text-embedding-v3（1024维）:
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_API_KEY=sk-xxxxx
#   config.yaml 中改: embedding=qwen, embedding_model=text-embedding-v3
# OpenAI text-embedding-3-small（1536维）:
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_API_KEY=sk-xxxxx
#   config.yaml 中改: embedding=openai, embedding_model=text-embedding-3-small
